# Backend Environment Configuration
# Copy this file as .env and fill in your actual values

# Server
PORT=5000
NODE_ENV=development

# Database (Laragon MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_skripsi

# JWT Secret (generate a long random string for production)
JWT_SECRET=atelier_hr_secret_2024_skripsi

# Email SMTP Configuration (for sending emails TO applicants)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Email IMAP Configuration (for RECEIVING applicant emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_hr_email@gmail.com
IMAP_PASS=your_gmail_app_password
IMAP_TLS=true

# Email polling interval in minutes
EMAIL_POLL_INTERVAL=5

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
